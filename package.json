{
  "name": "Flashback",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "main": "src/electron/main.js",
  "description": "The memorization workspace",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "npm run electron:rebuild && npm-run-all --parallel dev:react dev:electron",
    "dev:onboarding": "npm run electron:rebuild && npm-run-all --parallel dev:react dev:electron:onboarding",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:electron:onboarding": "cross-env NODE_ENV=development electron . --onboarding",
    "dev:api": "npm run rebuild && nodemon src/api/main.js",
    "dev:web": "npm run rebuild && npm-run-all --parallel dev:react dev:api",
    "build": "vite build",
    "react:build": "vite build",
    "rebuild": "npm rebuild better-sqlite3",
    "electron:rebuild": "electron-rebuild -f --debug",
    "electron:start": "electron .",
    "dist:win": "npm run electron:rebuild && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run electron:rebuild && npm run build && electron-builder --linux --x64",
    "dist:mac": "npm run electron:rebuild && npm run build && electron-builder --mac --arm64",
    "release": "node scripts/release.js",
    "test": "node scripts/run-tests.js unit integration legacy",
    "tests": "node scripts/run-tests.js unit integration legacy",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:legacy": "node scripts/run-tests.js legacy",
    "test:file": "node scripts/with-system-sqlite.js node --test",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.js",
    "check:tokens": "node scripts/check-tokens.js",
    "check:ui": "eslint . --max-warnings 0 && node scripts/check-contrast.js && node scripts/check-tokens.js && node --test tests/unit/translations.test.js \"tests/unit/ui.*.test.js\"",
    "translations": "node scripts/translations.js --open",
    "translations:check": "node scripts/translations.js --check",
    "seed": "node scripts/seed.js",
    "pure-token": "node scripts/pure-token.js",
    "vault:export": "node scripts/with-system-sqlite.js node scripts/vault-export.js",
    "vault:import": "node scripts/vault-import.js",
    "doctor": "react-doctor",
    "mcp": "node src/mcp/server.js",
    "bench:reviews": "node scripts/with-system-sqlite.js node scripts/bench-reviews.js",
    "server": "node --env-file-if-exists=.env src/server/main.js",
    "server:dev": "npm run rebuild && node src/server/main.js",
    "package:server": "node scripts/package-server.js",
    "package:server:standalone": "node scripts/package-server.js --with-node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeirdCatAFK/Flashback.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.8.0",
    "chardet": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "iconv-lite": "^0.7.0",
    "isomorphic-git": "^1.44.19",
    "jsdom": "^29.1.1",
    "knex": "^3.1.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.2.108",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "author": "Daniel Pineda Torres",
  "bugs": {
    "url": "https://github.com/WeirdCatAFK/Flashback/issues"
  },
  "homepage": "https://github.com/WeirdCatAFK/Flashback#readme",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.13.0",
    "@fontsource/didact-gothic": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-typography": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "d3-force": "^3.0.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.18.0",
    "epubjs": "^0.3.93",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "katex": "^0.17.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-doctor": "^0.4.2",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "tiptap-markdown": "^0.9.0",
    "vite": "^7.3.8"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.8.15"
    }
  }
}
