# Flashback Server. Copy to .env; all values optional.
#
# Where this file is read from:
#   npm run server    the repository root
#   Standalone zip    beside the launcher (resolved against ITS directory, not your shell's)
#   Docker Compose    beside docker-compose.yml — the repository root. Compose substitutes
#                     these into the compose file before the container is created, so they
#                     reach both the container AND the published port.
#   docker run -v     /data/.env, on the volume (there is no Compose to do the substituting)
#
# A real environment variable always wins over a line in this file.

# Everything the deployment owns. accounts.db is under here and cannot be rebuilt — back it up.
# IGNORED under Docker: the volume is mounted at a fixed /data.
#USER_DATA_PATH=./data

# Vault directory inside USER_DATA_PATH. Created if absent. One vault per server.
#FLASHBACK_VAULT_NAME=shared

#FLASHBACK_PORT=50500
#FLASHBACK_HOST=0.0.0.0

# COMPOSE ONLY: the host interface the port is published on. Loopback by default, so that
# exposing the server to the network is a deliberate edit here rather than the default. Leave
# it alone unless a TLS-terminating reverse proxy is not doing the exposing for you.
#FLASHBACK_BIND_ADDR=127.0.0.1

# COMPOSE ONLY: which published image tag to run. `latest`, or pin a version to make a
# rollback possible — see Upgrading in docs/SERVER.md.
#FLASHBACK_VERSION=latest

# Browser origins, comma-separated. Loopback and file:// are always allowed.
#FLASHBACK_ALLOWED_ORIGINS=https://flashback.example.com

# morgan format: dev | combined | common | short | tiny
#FLASHBACK_LOG_FORMAT=combined

# Ask GitHub once a day whether a newer release exists, and log the answer. `off` disables it
# and the server makes no outbound request at all. It never updates itself either way —
# migrations are one-way and this process holds the only copy of the workspace.
#FLASHBACK_UPDATE_CHECK=on

# Author of documents and Seal commits. Set both, before first start — otherwise the OS
# account is baked into a git history that outlives the container. Not authentication.
#FLASHBACK_USER_NAME=Flashback Server
#FLASHBACK_USER_EMAIL=server@example.com

# Adopt a token instead of having one minted and printed on first start. Never written to
# config.json (only its SHA-256 is stored), so this file is where the plaintext lives.
# Rotate with: npm run pure-token
#FLASHBACK_AUTHOR_TOKEN=
