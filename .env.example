# IGNORED under Docker: the volume is mounted at a fixed /data.
USER_DATA_PATH=./data

#The server refuses to start rather than resolve an invalid vault name.
#FLASHBACK_VAULT_NAME=shared

#FLASHBACK_PORT=50500
#FLASHBACK_HOST=0.0.0.0

# COMPOSE ONLY Leave it alone unless a TLS-terminating reverse proxy is not doing the exposing for you.
#FLASHBACK_BIND_ADDR=127.0.0.1

# COMPOSE ONLY: which published image tag to run. `latest`, or pin a version to make a
# rollback possible
FLASHBACK_VERSION=latest

# Browser origins, comma-separated.
FLASHBACK_ALLOWED_ORIGINS=https://flashback.example.com

# Ask GitHub once a day whether a newer release exists, and log the answer. `off` disables it
FLASHBACK_UPDATE_CHECK=on

# Author of documents and Seal commits. Set both, before first start  otherwise the OS
# account is baked into a git history that outlives the container. Not authentication.
FLASHBACK_USER_NAME=Flashback Server
FLASHBACK_USER_EMAIL=server@example.com

# Adopt a token instead of having one minted and printed on first start. Never written to
# config.json (only its SHA-256 is stored), so this file is where the plaintext lives.
# Rotate with: npm run pure-token
#FLASHBACK_AUTHOR_TOKEN=

# ── Splitting the vault across mounts

# Absolute CONTAINER paths, both unset by default.
# Flashback addresses different kinds of storage, which could benefit on having a different mount point for each
# Flashback storages has authorial items, index for fast queries and progress
# On an EXISTING deployment these are not safe to set on their own

#FLASHBACK_WORKSPACE_PATH=/canonical
#FLASHBACK_INDEX_PATH=/cache

# COMPOSE ONLY: host directory bind-mounted at /canonical. Must be chown'd to uid 1000 once
#FLASHBACK_CANONICAL_DIR=./workspace

# How much room this deployment actually has, e.g. 10GB, 512MB, 2TiB, or a byte count.
#FLASHBACK_STORAGE_LIMIT=10GB

# The most ACTIVE accounts this server may hold, the Author included. POST /api/accounts 
# Leave unset for no cap.
#FLASHBACK_MAX_ACCOUNTS=10
